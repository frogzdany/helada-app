        <mxCell id="title-group" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1750" height="83" as="geometry" /></mxCell>
        <mxCell id="title-text" value="Helada on AWS: what is deployed and how it is delivered" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="0" y="0" width="1200" height="42" as="geometry" /></mxCell>
        <mxCell id="subtitle-text" value="Serverless, almost no fixed cost. The phone page works offline; AWS serves it and keeps the office dashboard&#x27;s data durable. Two stages, dev and prod." style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="40" width="1400" height="25" as="geometry" /></mxCell>
        <mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="70" width="1740" height="10" as="geometry" /></mxCell>
